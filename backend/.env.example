# Copy to `.env` and adjust. All values are optional for local development.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave empty for SQLite. For production PostgreSQL:
# DATABASE_URL=postgres://user:password@localhost:5432/yacht_charter
DATABASE_URL=

CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# CSRF_TRUSTED_ORIGINS=https://admin.example.com
